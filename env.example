# BotHost provides BOT_TOKEN from its Bot Token field. Never commit the real token.
BOT_TOKEN=
BOT_USERNAME=RaspisanieMuBINT_bot
# Fill in the actual HTTPS domain after enabling it in BotHost.
# DOMAIN, when supplied by BotHost, is also supported automatically.
APP_URL=
PORT=3000
TZ=Europe/Moscow
DATABASE_PATH=/app/data/campus.sqlite
# Daily schedule check: 20:00 Europe/Moscow. The anchor only sets the first eligible day.
SCHEDULE_ANCHOR_DATE=2026-10-12
# Used only for local tests; keep 0 on the hosting platform.
DISABLE_BACKGROUND=0
